#!/bin/sh
#
# Перед створенням коміта: REQ-номер має стояти в трейлері «Закриває:», а не
# посеред тексту. Інакше коміт не створюється.
#
# ЧОМУ ЦЕ ВЗАГАЛІ ГЕЙТ. Хук post-commit рухає картки на дошці /dev-requests, і
# до 28.08.2026 він рухав КОЖНУ, чий номер траплявся в повідомленні. Але номер
# проситься в текст саме там, де пояснюєш причину («стара картка REQ-17 сюди не
# потрапляє»), — і тричі за дев'ять днів у «Готово локально» їхала картка, під
# якою немає ні рядка коду. Останнього разу деплой устиг зробити з неї
# «Викочено», а звідти картку вже не повернути ендпоінтом (409).
#
# Тепер намір заявляється рядком, а не вгадується з тексту:
#
#     Закриває: REQ-17
#     Закриває: REQ-180#p1, REQ-199#p2
#
# Уся інша проза — просто проза. Гейт лишає рівно два стани: або трейлер, або
# «картка 17» словами. Мовчазного третього більше немає.
#
# ТРЕЙЛЕР ЧИТАЄТЬСЯ ЛИШЕ З ПОЧАТКУ РЯДКА. Рядок з відступом — це приклад формату
# в тексті, а не намір; на цьому провалився найперший коміт із цим правилом, бо
# пояснював формат блоком коду. У прикладі пиши REQ-N замість справжнього
# номера: без цифр згадка не збігається взагалі.
#
# ЧОМУ ТУТ, А НЕ ПІСЛЯ КОМІТА. Тут падіння безкоштовне — коміта ще немає,
# повідомлення лишається в редакторі. Виправляти після факту довелось би через
# --amend чи reset --soft, а вони лишають сироту в tosho.commits, тобто зайвий
# рядок у розділі «Релізи».
#
# Вмикається разом з рештою хуків: git config core.hooksPath scripts/hooks
# (детальніше — у scripts/hooks/post-commit).
#
# Разовий обхід: git commit --no-verify або SKIP_CHECKS=1 git commit
#
# Уся логіка — у scripts/lib/devRequestCommitGate.mjs; тут лише запуск, щоб
# розбір повідомлення був покритий тестами, а не жив у шелі.

# node може не бути в PATH у графічних git-клієнтів. Без нього перевірити ми
# нічого не можемо — але й блокувати роботу через це не станемо.
command -v node >/dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
gate="$root/scripts/lib/devRequestCommitGate.mjs"
[ -f "$gate" ] || exit 0

node "$gate" "$1"
