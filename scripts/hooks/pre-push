#!/bin/sh
#
# Перед пушем робимо дві різні речі:
#   1) ПЕРЕВІРЯЄМО КОД — і блокуємо пуш, якщо він зламаний;
#   2) оновлюємо робочі години — тихо, ніколи не блокуючи.
#
# ═══════════════════════════════════════════════════════════════════════
# 1. ПЕРЕВІРКИ (блокують)
# ═══════════════════════════════════════════════════════════════════════
#
# НАВІЩО САМЕ ТУТ, А НЕ ЛИШЕ В CI. Пуш у main = деплой Netlify = ~15 кредитів
# плоскою ставкою при бюджеті ≈40 деплоїв на місяць. GitHub Actions запускається
# ПАРАЛЕЛЬНО з деплоєм і зупинити його не може: коли Actions почервоніє, кредити
# вже витрачені, а на хотфікс піде ще стільки ж. Єдине місце, де помилку ще можна
# спіймати безкоштовно, — ось це, до того як пуш пішов з машини.
#
# ЦІНА. Близько хвилини (найдовший — lint, ~47 с). Пушимо ми рідко й дорого,
# тож хвилина перед деплоєм окупається з першого спійманого падіння.
#
# Остання перевірка в списку — «адреси кронів» — єдина, що дивиться в ЖИВУ базу:
# розклад крона зберігає URL функції рядком, тож перейменування файлу лишає джоб
# стукати за старою адресою. Без бази (CI, свіжий клон) вона мовчки пропускається.
#
# ЯК ОБІЙТИ, КОЛИ ПРОД ЛЕЖИТЬ І ТРЕБА ХОТФІКС НЕГАЙНО:
#     SKIP_CHECKS=1 git push
# або штатне git push --no-verify (вимкне заразом і оновлення годин).
#
# ═══════════════════════════════════════════════════════════════════════
# 2. РОБОЧІ ГОДИНИ (ніколи не блокують)
# ═══════════════════════════════════════════════════════════════════════
#
# НАВІЩО. Розділ «Релізи» показує два прилади поруч: години з транскриптів
# Claude Code (tosho.work_sessions) і оцінку за ритмом комітів. Другий
# оновлюється сам — його пише плагін Netlify після кожного успішного деплою.
# Перший до 2026-08-09 запускали руками, і він регулярно відставав: 9 серпня
# сторінка показувала «≈1.7 год» о другій дня, бо востаннє скрипт ганяли
# о 08:48. Виглядало як помилка розрахунку, хоча дані просто були вчорашні.
#
# Пуш — правильний момент: саме тоді оновиться й друга половина картини, тож
# обидва прилади міряють один і той самий відрізок часу.
#
# ЦЕ НЕ ЄДИНИЙ ЗАХИСТ. Якщо працювати добу без пушу, години все одно відстануть.
# Постійний фон — окремо (див. scripts/hooks/README.md), а хук лишається
# гарантією «на момент деплою дані свіжі».
#
# НІКОЛИ НЕ БЛОКУЄ ПУШ. Години — довідка, а не умова деплою: будь-яка невдача
# тут гасне мовчки. Пуш, що не відбувся через статистику, коштує дорожче за
# саму статистику.

set -u

# ───────────────────────────── перевірки ─────────────────────────────

if [ "${SKIP_CHECKS:-}" = "1" ]; then
  echo "[перевірки] пропущено через SKIP_CHECKS=1"
elif [ ! -d node_modules ]; then
  echo "[перевірки] node_modules немає — пропускаю. Постав залежності: npm ci"
else
  echo "[перевірки] ганяю перед пушем — приблизно хвилина"
  failed=""
  for check in \
    "типи застосунку|npx tsc --noEmit" \
    "лінт + борг компілятора|node scripts/check-compiler-debt.mjs" \
    "тести|npm run test --silent" \
    "типи функцій|npm run typecheck:functions --silent" \
    "реєстр функцій|npm run check:functions --silent" \
    "ключі фіч|npm run check:feature-keys --silent" \
    "реєстр поверхонь|npm run check:page-surfaces --silent" \
    "копії спільних модулів|npm run check:duplicate-singletons --silent" \
    "заглушки правил хуків|node scripts/check-hook-disables.mjs" \
    "розростання файлів|node scripts/check-file-growth.mjs" \
    "адреси кронів|set -a; . ./.env.backup 2>/dev/null; set +a; node scripts/check-cron-endpoints.mjs"
  do
    name=${check%%|*}
    cmd=${check#*|}
    # Без вирівнювання по колонках навмисно: printf рахує БАЙТИ, а не символи,
    # тож кирилиця в %-18s їде. Рівні стовпчики не варті підрахунку ширини.
    printf "[перевірки]   %s" "$name"
    if out=$(eval "$cmd" 2>&1); then
      echo " → ок"
    else
      echo " → ПАДАЄ"
      failed="$failed $name"
      echo "$out" | tail -15 | sed 's/^/[перевірки]     /'
    fi
  done

  if [ -n "$failed" ]; then
    echo ""
    echo "[перевірки] ✖ пуш зупинено. Не пройшли:$failed"
    echo "[перевірки]   Полагодь і пушни ще раз."
    echo "[перевірки]   Якщо прод лежить і хотфікс треба негайно: SKIP_CHECKS=1 git push"
    exit 1
  fi
  echo "[перевірки] ✓ усе чисто"
fi

# ─────────────────────────── робочі години ───────────────────────────

# Транскрипти лежать локально, а psql і доступ до бази є не всюди (CI, чужа
# машина, свіжий клон). Немає чогось із трьох — просто нічого не робимо.
[ -f .env.backup ] || exit 0
command -v psql >/dev/null 2>&1 || exit 0
command -v node >/dev/null 2>&1 || exit 0

# Тиждень назад: доганяємо дні, які могли пропустити, не читаючи всю історію.
# BSD-варіант (macOS) і GNU-варіант (Linux) — беремо той, що спрацює.
SINCE=$(date -v-7d +%F 2>/dev/null || date -d '7 days ago' +%F 2>/dev/null || echo "")

(
  set -a
  # shellcheck disable=SC1091
  . ./.env.backup
  set +a
  if [ -n "$SINCE" ]; then
    node scripts/record-work-hours.mjs --since="$SINCE"
  else
    node scripts/record-work-hours.mjs
  fi
) 2>&1 | sed 's/^/[години] /' || true

# ─────────────────────────── журнал комітів ──────────────────────────

# Підмітання за гаком post-commit: він міг не спрацювати (не встановлений на цій
# машині, не було мережі, коміти прийшли мерджем). Ідемпотентно за sha, тож
# зайвий прохід нічого не псує.
(
  set -a
  # shellcheck disable=SC1091
  . ./.env.backup
  set +a
  TOSHO_COMMITS_VERBOSE=1 node scripts/record-commits.mjs --limit=200
) 2>&1 | sed 's/^/[коміти] /' || true

exit 0
