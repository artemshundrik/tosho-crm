#!/bin/sh
#
# Після коміта: якщо в ньому є трейлер «Закриває: REQ-N» — картка на дошці
# /dev-requests сама їде в «Готово локально». Немає трейлера — хук мовчки
# виходить. Номер, що просто трапився в тексті, не рахується: чому саме так —
# у scripts/hooks/commit-msg, який такий коміт і не дає створити.
#
# ── ЯК УВІМКНУТИ ──────────────────────────────────────────────────────────────
#
#   git config core.hooksPath scripts/hooks
#
# Одноразово, на кожній машині окремо. Теку .git/hooks закомітити не можна, тому
# сам хук лежить у репозиторії, а команда вище каже git'у шукати хуки саме тут.
#
# ПЕРЕД ТИМ як виконувати, перевір, чи налаштування вже не зайняте:
#
#   git config core.hooksPath      # порожньо — можна ставити
#   ls .git/hooks                  # самі *.sample — нічого не втратиш
#
# Якщо там уже щось є (husky або власні хуки) — НЕ перезаписуй: перенеси цей
# файл у ту теку, яку git уже читає. Значення в core.hooksPath рівно одне, і
# друге просто вимкне перше — мовчки.
#
# Вимкнути: git config --unset core.hooksPath
#
# ── ЧОГО ХУК НЕ РОБИТЬ ────────────────────────────────────────────────────────
#
# Не валить коміт. Ніколи. Немає node, немає токена, впала мережа — вихід 0 і
# щонайбільше попередження. Коміт уже стався, і рядок на дошці не вартий того,
# щоб через нього втратити роботу.
#
# Токен береться з ~/.claude/skills/tosho-request/.env (той самий, що в скіла)
# або зі змінної оточення TOSHO_CAPTURE_TOKEN. Немає — тиша.
#
# Уся логіка — у scripts/lib/devRequestCommitHook.mjs; тут лише запуск. Так
# розбір теми коміта покритий тестами (scripts/lib/devRequestCommitHook.test.mjs),
# а не живе в шелі, де його ніхто не перевіряє.

# node може не бути в PATH у графічних git-клієнтів — це не привід шуміти.
command -v node >/dev/null 2>&1 || exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
hook="$root/scripts/lib/devRequestCommitHook.mjs"
[ -f "$hook" ] || exit 0

# `|| true` навмисно: що б там не сталось, коміт лишається успішним.
node "$hook" || true

# ── Журнал комітів ───────────────────────────────────────────────────────────
#
# Сторінка «Релізи» має показувати день роботи ОДРАЗУ, а не після деплою: поки
# коміти приходили лише з релізом, день без пушу виглядав порожнім, хоч години
# за нього вже записані. Тому пишемо рядок тут-таки, на коміті.
#
# Так само тихо, як усе інше в цьому гаку: немає .env.backup чи psql (чужа
# машина, свіжий клон, CI) — просто не робимо нічого.
if [ -f "$root/.env.backup" ] && command -v psql >/dev/null 2>&1; then
  (
    cd "$root" || exit 0
    set -a
    # shellcheck disable=SC1091
    . ./.env.backup
    set +a
    node scripts/record-commits.mjs --limit=20
  ) >/dev/null 2>&1 || true
fi

exit 0
