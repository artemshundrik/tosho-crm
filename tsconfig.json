{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    // TypeScript 6 більше не підтягує всі @types автоматично: типовим значенням
    // стало [], тож перелік потрібен явний. Тут відтворено те, що завантажувалось
    // само на 5.9 і справді використовується: vite/client дає import.meta.env,
    // node — імпорти node:* у тестах (src/lib/catalogMethodName.test.ts).
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
