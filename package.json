{
  "name": "tosho-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-netlify-functions.mjs",
    "build": "tsc -b && vite build",
    "analyze": "ANALYZE=1 vite build",
    "lint": "eslint .",
    "lint:compiler": "eslint . -c eslint.compiler.config.mjs",
    "check:compiler-debt": "node scripts/check-compiler-debt.mjs",
    "check:duplicate-singletons": "node scripts/check-duplicate-singletons.mjs",
    "check:feature-keys": "node scripts/check-feature-keys.mjs",
    "check:file-growth": "node scripts/check-file-growth.mjs",
    "check:hook-disables": "node scripts/check-hook-disables.mjs",
    "check:functions": "node scripts/check-netlify-functions.mjs",
    "check:page-surfaces": "node scripts/check-page-surfaces.mjs",
    "typecheck:functions": "tsc -p netlify/functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "migrate:avatars": "node scripts/migrate-avatar-storage.mjs",
    "migrate:avatar-variants": "node scripts/migrate-avatar-variants.mjs",
    "migrate:attachment-previews": "node scripts/migrate-attachment-previews.mjs",
    "migrate:catalog-images": "node scripts/migrate-catalog-model-images.mjs",
    "migrate:customer-logos": "node scripts/migrate-customer-lead-logos.mjs",
    "migrate:raster-attachment-variants": "node scripts/migrate-raster-attachment-variants.mjs",
    "sync:quote-logo-snapshots": "node scripts/sync-quote-logo-snapshots.mjs",
    "audit:attachments": "node scripts/audit-attachment-storage.mjs",
    "audit:catalog-images": "node scripts/audit-catalog-model-images.mjs",
    "audit:customer-logos": "node scripts/audit-customer-lead-logos.mjs",
    "cleanup:attachments": "node scripts/cleanup-attachment-storage.mjs",
    "eval:tosho-ai": "node scripts/run-tosho-ai-evals.mjs",
    "export:orphan-attachments": "node scripts/export-orphan-attachment-originals.mjs",
    "export:orphan-attachment-summary": "node scripts/export-orphan-attachment-summary.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "stack:snapshot": "node scripts/build-stack-snapshot.mjs",
    "check:stack-snapshot": "node scripts/check-stack-snapshot.mjs"
  },
  "overrides": {
    "react-day-picker": {
      "react": "$react"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.86.2",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.90.18",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/extension-link": "^3.23.5",
    "@tiptap/extension-underline": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.5",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.560.0",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.8",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.2.8",
    "react-easy-crop": "^5.5.6",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.6.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "netlify-cli": "^24.10.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
