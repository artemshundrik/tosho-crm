{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "netlify",
        "dev"
      ],
      "port": 8888
    },
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "preview-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "5200",
        "--strictPort"
      ],
      "port": 5200
    }
  ]
}
